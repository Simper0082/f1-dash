# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker command)
TUNNEL_TOKEN=

# Browser-facing address of the realtime service (must be https when the dashboard is https)
LIVE_URL=https://f1-live.simperandco.com

# Browser origins allowed to call realtime and api, separated by ';'
# Add your LAN address if you also open the dashboard from http://<lxc-ip>:3000
ORIGINS=https://f1.simperandco.com;http://localhost:3000
